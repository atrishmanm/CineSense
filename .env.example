# TMDB API Configuration
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_BASE_URL=https://api.themoviedb.org/3
# HTTP timeout (seconds) for TMDB requests (tmdb/fetcher.py: TMDB_TIMEOUT_SECONDS)
TMDB_TIMEOUT_SECONDS=6

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=cinesense

# Flask Configuration
FLASK_APP=app_integrated.py
FLASK_ENV=development
SECRET_KEY=your_secret_key_here
PORT=5000

# AI Configuration
LEARNING_RATE=0.1
EXPLORATION_RATE=0.2
INITIAL_ELO_SCORE=1500

# Model Paths
MODEL_DIR=./model
CHECKPOINT_DIR=./checkpoints

# Deep Learning Ensemble - OFFLINE / RESEARCH ONLY.
# DL scoring stays OFF by default; checkpoints are not bundled.
USE_DL_SCORING=0
DL_V2_CHECKPOINT=cinesense_v2.pt
DL_V1_CHECKPOINT=cinesense_model_final.pt

# Redis Caching (optional - app runs without it)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# AI model behavior.
# *_LOCAL_ONLY=1 forbids downloading HF/CLIP weights (use cached/local models).
MOOD_MODELS_LOCAL_ONLY=0
SEMANTIC_LOCAL_ONLY=0
VISUAL_SEARCH_LOCAL_ONLY=0
VISUAL_SEARCH_INDEX_LIMIT=500
VISUAL_SEARCH_MODEL_LOAD_RETRIES=2
VISUAL_SEARCH_INDEX_RETRIES=3
